{
  "name": "Format-Code",
  "version": "2.2.2",
  "description": "A Figma plugin designed to allow you to format and syntax highlighting code",
  "main": "code.js",
  "scripts": {
    "dev": "concurrently -n plugin,ui \"npm run build:plugin -- --watch\" \"vite\"",
    "build": "npm run build:ui && npm run build:plugin",
    "build:plugin": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6",
    "build:ui": "vite build",
    "preview": "vite preview",
    "tsc": "oxlint --type-aware --type-check",
    "prettier": "prettier --write ./**/*",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Candido Sales Gomes <candidosg@gmail.com>",
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "dependencies": {
    "flourite": "1.3.0",
    "prettier": "3.9.6",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "1.0.0",
    "@figma/plugin-typings": "1.133.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "9.2.1",
    "esbuild": "0.27.3",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "sass": "1.97.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^4.1.10"
  }
}
